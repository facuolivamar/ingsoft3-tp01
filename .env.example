# Copiar a .env antes de levantar:  cp .env.example .env
#
# El .env NO se versiona (esta en .gitignore). Este archivo si, porque documenta
# QUE variables hacen falta sin revelar sus valores reales.

POSTGRES_USER=salas
POSTGRES_PASSWORD=cambiame_en_tu_env
POSTGRES_DB=salas

# Puertos publicados en la maquina host
PUERTO_WEB=8080
PUERTO_API=8000

# Namespace del registry para docker-compose.registry.yml (usuario de GitHub en
# minusculas, o tu usuario de Docker Hub)
REGISTRY=ghcr.io/facuolivamar
TAG=v0.1.0
